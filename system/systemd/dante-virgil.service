[Unit]
Description=Virgil
Documentation=https://github.com/BRCook/dante-virgil
After=network-online.target polkit.service
Wants=network-online.target

[Service]
Type=simple
User=dante-virgil
Group=dante-virgil
ExecStart=/opt/dante-virgil/venv/bin/virgild
# Always, not only on failure: virgild is never meant to stop by itself, so if it ever exits cleanly (status 0),
# that's a fault too, and it should come back. "systemctl stop" still stops it.
Restart=always
RestartSec=2

# virgild only needs to write its config and its requests to virgil-root.
# It starts and stops the timing units through polkit, not by itself.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/dante-virgil /run/dante-virgil
# The record of alerts, kept across reboots.
StateDirectory=dante-virgil
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# More of the same: things virgild never does, so can't be made to do.
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

# Watching PTP on the PTP interface needs a raw socket, and the web UI on
# ports 80 and 443 needs the right to open them. Nothing more.
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
