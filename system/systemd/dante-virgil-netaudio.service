[Unit]
Description=Virgil: netaudio's daemon, for monitoring the local Dante devices
Documentation=https://github.com/BRCook/netaudio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A user of its own, not virgild's: netaudio parses traffic from Dante devices, and brings many dependencies, so a
# flaw in it mustn't reach Virgil's config, password hash, TLS key or root requests. It can't read any of them.
User=dante-virgil-netaudio
Group=dante-virgil-netaudio
# Written by virgild: NETAUDIO_INTERFACE, the PTP interface the Dante devices are on. systemd reads it, as root,
# before starting netaudio, so netaudio's user needn't be able to.
EnvironmentFile=/run/dante-virgil/netaudio.env
# netaudio keeps its history and caches under its home (~/.local/share/netaudio, ~/.cache/netaudio).
Environment=HOME=/var/lib/dante-virgil-netaudio
Environment=NETAUDIO_NO_SSL=1
StateDirectory=dante-virgil-netaudio
StateDirectoryMode=0700
# Loopback only: nothing on the network can reach netaudio's API.
ExecStart=/opt/dante-virgil/venv/bin/netaudio daemon run --listen 127.0.0.1 --port 4780
# virgild starts this once the PTP interface has an address; this is only a backstop.
Restart=on-failure
RestartSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
