// Let Virgil's daemon start, stop and restart Virgil's timing units, and
// nothing else. dante-virgil.service itself doesn't match.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units" ||
        subject.user != "dante-virgil") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (/^dante-virgil-[a-z0-9]+\.service$/.test(unit) &&
        ["start", "stop", "restart"].indexOf(verb) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
